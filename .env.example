# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your environment configuration.
# WARNING: NEVER commit actual credentials, secret keys, or database passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server / API Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_waste_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgres://postgres:your_secure_password_here@localhost:5432/food_waste_db

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------------------------
# AWS Services (IAM Role preferred in EC2; local dev uses local mock or credentials)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_placeholder
AWS_S3_BUCKET_NAME=nie-food-waste-photos-bucket-placeholder
AWS_S3_PRESIGNED_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# CloudWatch Monitoring & Logging
# ------------------------------------------------------------------------------
CLOUDWATCH_LOG_GROUP=/aws/food-waste-management-system/api
CLOUDWATCH_LOG_STREAM=local-development

# ------------------------------------------------------------------------------
# Client / Frontend Configuration (Vite requires VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
